# JbTunez - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-make-it-long-and-random
PORT=5000

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard/
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:5000/callback

# Optional: Redis for session storage (production)
# REDIS_URL=redis://localhost:6379

# Optional: Database URL (if you want to add user persistence)
# DATABASE_URL=sqlite:///jbtunez.db

# Optional: Analytics and Monitoring
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Optional: Feature Flags
ENABLE_PREVIEW_PLAYBACK=true
ENABLE_PLAYLIST_CREATION=false
ENABLE_SOCIAL_SHARING=false
MAX_RECOMMENDATIONS=20
CACHE_TIMEOUT=3600